# Copy this file to `backend/.env` and fill in the real values, OR get the
# ready-made `backend/.env` from the team group chat.
# `.env` is gitignored and must never be committed. This `.env.example` is the
# committed template — keep it in sync when the required variables change.
#
# Load it before starting the server:  `source .env && mvn spring-boot:run`

# Claude (Anthropic) API key — https://console.anthropic.com/settings/keys
export ANTHROPIC_API_KEY=sk-ant-...

# Supabase project reference ID — the "xxxx" in https://xxxx.supabase.co
# (Project Settings -> General -> Reference ID). Used to build the JWKS URL the
# backend uses to verify Supabase access tokens. The project MUST be on
# asymmetric JWT keys (Authentication -> JWT Keys -> "Migrate JWT secret"),
# otherwise token verification fails with "Another algorithm expected".
export SUPABASE_PROJECT_REF=xxxx

# Postgres direct connection (Project Settings -> Database -> Connection string
# -> Direct connection). If your network can't reach db.<ref>.supabase.co:5432
# (some IPv4-only networks can't), use the "Session pooler" connection string
# instead — same database, different host/port, and username postgres.<ref>.
export SUPABASE_DB_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres

# Database password (Project Settings -> Database -> Reset database password).
# Shared across the whole team — if anyone resets it, EVERYONE's .env breaks
# until the new password is re-shared.
export SUPABASE_DB_PASSWORD=your-database-password

# Optional — defaults to "postgres". Set to postgres.<ref> if using the pooler.
# export SUPABASE_DB_USER=postgres
