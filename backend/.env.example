# Copy this file to `backend/.env` and fill in the real values, OR get the
# ready-made `backend/.env` from the team group chat.
# `.env` is gitignored and must never be committed. This `.env.example` is the
# committed template — keep it in sync when the required variables change.
#
# Load it before starting the server:  `source .env && mvn spring-boot:run`

# Claude (Anthropic) API key — https://console.anthropic.com/settings/keys
export ANTHROPIC_API_KEY=sk-ant-...

# Supabase project reference ID — the "xxxx" in https://xxxx.supabase.co
# (Project Settings -> General -> Reference ID). Used to build the JWKS URL the
# backend uses to verify Supabase access tokens. The project MUST be on
# asymmetric JWT keys (Authentication -> JWT Keys -> "Migrate JWT secret"),
# otherwise token verification fails with "Another algorithm expected".
export SUPABASE_PROJECT_REF=xxxx

# Postgres Session pooler connection (Project Settings -> Database -> Connection
# string -> Session pooler). Copy the host from the dashboard: the regional
# prefix matters (this project is aws-1-us-east-2, NOT aws-0-us-east-2), and a
# wrong prefix fails with "tenant/user not found".
#
# Do NOT use the direct host, db.<ref>.supabase.co. It resolves to an IPv6
# address and has no IPv4 address at all, so it is unreachable from any network
# without working IPv6 — which is most campus, guest, office, and wired
# networks. The symptom is "NoRouteToHostException: No route to host", which
# looks like a credentials problem but is not. The pooler has an IPv4 address
# and reaches the same database, so it works on every network.
export SUPABASE_DB_URL=jdbc:postgresql://aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Required by the pooler: "postgres." + your project ref (NOT plain "postgres",
# which fails with "tenant/user not found").
export SUPABASE_DB_USER=postgres.xxxx

# Database password (Project Settings -> Database -> Reset database password).
# Shared across the whole team — if anyone resets it, EVERYONE's .env breaks
# until the new password is re-shared. A connection failure is far more likely
# to be the IPv6 issue above than a bad password, so check that first.
export SUPABASE_DB_PASSWORD=your-database-password
