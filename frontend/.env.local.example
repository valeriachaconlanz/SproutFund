# Copy this file to `frontend/.env.local` and fill in the real values, OR get
# the ready-made `.env.local` from the team group chat.
# `.env.local` is gitignored. Restart `npm run dev` after changing it — Vite
# only reads env vars at startup.

# Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://xxxx.supabase.co

# Project Settings -> API -> anon / publishable key (starts with sb_publishable_
# for modern keys, or eyJ... for a legacy anon JWT). This key is safe to ship to
# the browser; it only allows what your RLS policies permit.
VITE_SUPABASE_ANON_KEY=sb_publishable_...
